@model IEnumerable<Library.Models.BookIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="Create" asp-controller="Book" type="submit" class="btn btn-primary">Create</a>
</div>

<div class="h1">
    Books
</div>
<form asp-controller="Book" asp-action="Index" method="get">
    <div class="card-body p-4">
        <h5>Search Books</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Year published</label>
                <input type="number" name="year" value="@ViewBag.SearchYear"
                       class="form-control rounded-3" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Book Title</label>
                <input type="text" name="title" value="@ViewBag.SearchTitle"
                       class="form-control rounded-3" />
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input type="checkbox" name="borrowedOnly" value="true"
                           class="form-check-input" id="borrowedOnly"
                           checked="@(ViewBag.BorrowedOnly == true)" />
                    <label class="form-check-label" for="borrowedOnly">
                        Currently borrowed
                    </label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary rounded-3">Search</button>
        </div>
    </div>
</form>

<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Title</th>
                <th scope="col">Author</th>
                <th scope="col">Year published</th>
                <th scope="col">Available</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
            @foreach (var book in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublishedYear</td>
                    <td>@book.IsAvailable</td>
                    <td>
                        <a asp-action="Update" asp-controller="Book" asp-route-id="@book.Id" type="submit" class="btn btn-success">Update title</a>
                        <a asp-action="Delete" asp-controller="Book" asp-route-id="@book.Id" type="submit" class="btn btn-danger">Delete</a>

                    </td>
                </tr>
                <tr>
                    
                       @rowNumber++;
                    
                </tr>
                
                    }
                }
                else
                {
                    <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="display-4 mb-3"></div>
                                <h5 class="fw-bold">Your library is empty</h5>
                                
                            </td>
                        </tr>
                }
            </tbody>
    </table>
</form>