@model IEnumerable<Library.Models.BookIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="Create" asp-controller="Book" type="submit" class="btn btn-primary">Create</a>
</div>

<div class="h1">
    Books
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Title</th>
                <th scope="col">Author</th>
                <th scope="col">Year published</th>
                <th scope="col">Available</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
            @foreach (var book in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublishedYear</td>
                    <td>@book.IsAvailable</td>
                    <td>
                        <a asp-action="Details" asp-controller="Book" asp-route-id="@book.Id" type="submit" class="btn btn-info">Details</a>
                        <a asp-action="Update" asp-controller="Book" asp-route-id="@book.Id" type="submit" class="btn btn-success">Update</a>
                        <a asp-action="Delete" asp-controller="Book" asp-route-id="@book.Id" type="submit" class="btn btn-danger">Delete</a>

                    </td>
                </tr>
                <tr>
                    
                       @rowNumber++;
                    
                </tr>
                
                    }
                }
                else
                {
                    <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="display-4 mb-3"></div>
                                <h5 class="fw-bold">Your library is empty</h5>
                                
                            </td>
                        </tr>
                }
            </tbody>
    </table>
</form>